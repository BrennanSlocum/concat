#!/usr/bin/env bash
set -euo pipefail

VERSION=1.1
VERDATE="October 11, 2026"

usage() {
    cat <<EOF
concat file1 file2 [file3 ...]

options:
  -h    show help
  -v    show version
EOF
    exit 0
}

ver() {
    printf '%s %s\n' "$VERSION" "$VERDATE"
    exit 0
}

getBirthTime() {
    local file="$1"
    local fileBn
    fileBn="$(basename "$file")"

    if [[ "$fileBn" =~ ^re\!([0-9]+)~([0-9]+)_([0-9]+)_([0-9]+)(\+[0-9]+)?\.* ]]; then
        local day="${BASH_REMATCH[1]}"
        local hour="${BASH_REMATCH[2]}"
        local min="${BASH_REMATCH[3]}"
        local sec="${BASH_REMATCH[4]}"

        # Timestamp in seconds.
        local timestamp
        timestamp=$(( 10#$day*24*60*60 + 10#$hour*60*60 + 10#$min*60 + 10#$sec ))

        printf '%s\n' "$timestamp"
    fi
}

getDuration() {
    local file="$1"
    local fileDur

    if fileDur=$(
        ffprobe \
            -v error \
            -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 \
            "$file"
    ); then
        printf '%s' "$fileDur"
    fi
}


###############################################################################
# Parse arguments
###############################################################################

currentWorkingDir="$(pwd)"
files=()

while (($#)); do
    case "$1" in
        -h|--help)
            usage
            ;;

        -v|--version)
            ver
            ;;

        *)
            if [[ -f "$1" ]]; then
                files+=("$1")
            fi
            ;;
    esac

    shift
done

if (( ${#files[@]} < 2 )); then
    printf '%s\n' "error: at least two files are required" >&2
    exit 1
fi


###############################################################################
# Print input files
###############################################################################

printf '\nInput files:\n'

for ((i = 0; i < ${#files[@]}; i++)); do
    printf '  %d: %s\n' "$((i + 1))" "${files[i]}"
done

printf '\n'


###############################################################################
# Get timestamps
###############################################################################

birthTimes=()

for file in "${files[@]}"; do
    birthTime="$(getBirthTime "$file")"

    if [[ -z "$birthTime" ]]; then
        printf 'error: could not determine timestamp from filename: %s\n' \
            "$file" >&2
        exit 1
    fi

    birthTimes+=("$birthTime")
done


###############################################################################
# Verify chronological order
###############################################################################

for ((i = 1; i < ${#birthTimes[@]}; i++)); do
    if (( birthTimes[i] < birthTimes[i - 1] )); then
        printf 'error: files are not in chronological order:\n' >&2
        printf '  %s\n' "${files[i - 1]}" >&2
        printf '  %s\n' "${files[i]}" >&2
        exit 1
    fi
done


###############################################################################
# Create temporary directory
###############################################################################

tmpDir="$(mktemp -d)"

cleanup() {
    rm -rf "$tmpDir"
}

trap cleanup EXIT


###############################################################################
# Calculate trim durations and create trimmed files
###############################################################################

trimmedFiles=()

for ((i = 0; i < ${#files[@]}; i++)); do

    file="${files[i]}"
    fileDur="$(getDuration "$file")"

    if [[ -z "$fileDur" ]]; then
        printf 'error: could not determine duration of %s\n' "$file" >&2
        exit 1
    fi

    ###########################################################################
    # Every file except the last one is trimmed at the start of the next file.
    ###########################################################################

    if (( i < ${#files[@]} - 1 )); then

        trimDuration="$(
            awk \
                -v start="${birthTimes[i]}" \
                -v finish="${birthTimes[i + 1]}" \
                'BEGIN {
                    printf "%.6f", finish - start
                }'
        )"

        # Never trim beyond the actual duration of the file.
        if awk -v cut="$trimDuration" -v dur="$fileDur" \
            'BEGIN { exit !(cut >= dur) }'
        then
            trimDuration="$fileDur"
        fi

    else
        # Last file: keep the whole thing.
        trimDuration="$fileDur"
    fi

    printf 'File %d:\n' "$((i + 1))"
    printf '  start:    %s\n' "${birthTimes[i]}"
    printf '  duration: %s\n' "$fileDur"
    printf '  keeping:  %s seconds\n' "$trimDuration"

    ###########################################################################
    # Temporary output.
    ###########################################################################

    trimmed="$tmpDir/part-${i}.mp4"

    trimmedFiles+=("$trimmed")

    ###########################################################################
    # Trim and normalize timestamps.
    #
    # We re-encode here so that all temporary files have consistent streams
    # for the final concat.
    ###########################################################################

    ffmpeg -y \
        -i "$file" \
        -t "$trimDuration" \
        -c copy \
        "$trimmed"
    # -map 0:v:0 \
    # -map 0:a:0 \
    # -reset_timestamps 1 \
    # -c:v libx264 \
    # -c:a aac \
done

###############################################################################
# Create concat file
###############################################################################

filelist="$tmpDir/filelist.txt"

: > "$filelist"

for file in "${trimmedFiles[@]}"; do
    # Escape single quotes for ffmpeg's concat demuxer syntax.
    escaped="${file//\'/\'\\\'\'}"

    printf "file '%s'\n" "$escaped" >> "$filelist"
done



###############################################################################
# Final output name
###############################################################################

firstFile="${files[0]}"

firstBN="$(basename "$firstFile")"
firstBNstem="${firstBN%.*}"
firstBNext="${firstBN##*.}"

# Calculate the total time covered by all concatenations.
#
# Example:
#
#   file1 @ 44
#   file2 @ 48
#   file3 @ 51
#   file4 @ 63
#
#   4 + 3 + 12 = 19
#
# Output:
#
#   re!08~18_41_44+19.mp4

totalConcatDuration="$(
    awk -v first="${birthTimes[0]}" \
        -v last="${birthTimes[${#birthTimes[@]} - 1]}" \
        'BEGIN {
            printf "%.6f", last - first
        }'
)"

# Remove unnecessary decimal zeroes.
totalConcatDuration="$(
    printf '%s' "$totalConcatDuration" |
        sed -E 's/0+$//; s/\.$//'
)"

finishedOUT="${currentWorkingDir}/${firstBNstem%%+*}+${totalConcatDuration}.${firstBNext}"

###############################################################################
# Final concat
###############################################################################

printf '\nConcatenating...\n'
printf 'filelist: %s\n' "$filelist"
printf 'output:   %s\n\n' "$finishedOUT"

ffmpeg -y \
    -f concat \
    -safe 0 \
    -i "$filelist" \
    -c copy \
    "$finishedOUT"


for file in "${files[@]}"; do
    gio trash -- "$file"
done

###############################################################################
# Done
###############################################################################

printf '%b\n' \
    "made file \033[0;34m$finishedOUT\033[0m"
